{
  "name": "victoriametrics-metrics-datasource",
  "version": "0.25.2",
  "description": "Showcase how to build a basic datasource plugin",
  "scripts": {
    "build:lezer-metricsql": "cd packages/lezer-metricsql && bash build.sh",
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch --onlyChanged",
    "test:watch": "jest --watch",
    "test:coverage": "jest --collectCoverage",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "lint": "eslint --cache .",
    "lint:fix": "yarn run lint --fix",
    "server": "docker compose up --build",
    "sign": "[ -z $GRAFANA_ACCESS_POLICY_TOKEN ] && echo 'skip plugin signing' || sign-plugin",
    "postinstall": "rm -rf node_modules/flatted/golang"
  },
